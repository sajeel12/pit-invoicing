# Copy this file to .env.local and fill in your values. .env.local is gitignored.

# Which FBR environment to target.
#   sandbox    -> uses *_sb endpoints, requires scenarioId on invoices (for scenario testing)
#   production -> uses live endpoints, scenarioId is omitted
FBR_ENV=sandbox

# Bearer token issued by PRAL inside the IRIS portal.
# For sandbox testing you may use the public sandbox token below until your own is issued:
#   906b1cd8-0d10-3a91-8234-8ec88e376bd7
# Once you pass scenario testing, replace this with your PRODUCTION token and set FBR_ENV=production.
FBR_TOKEN=906b1cd8-0d10-3a91-8234-8ec88e376bd7

# Your seller details — used to prefill the seller section of the form.
SELLER_NTNCNIC=
SELLER_BUSINESS_NAME=
SELLER_PROVINCE=
SELLER_ADDRESS=

# ---- Login (single shared account) ----
# The form, history and submit APIs require login. Set a username and a strong
# password. Until LOGIN_PASSWORD is set, login fails closed (no access).
LOGIN_USER=perceptionit
LOGIN_PASSWORD=
# Secret used to sign the session cookie. Set to a long random string, e.g.
#   openssl rand -hex 32
# If unset, the app falls back to FBR_TOKEN (works, but set this in production).
AUTH_SECRET=
